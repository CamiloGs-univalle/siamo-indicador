rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: verificar rol ──────────────────────────────────
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return request.auth != null && getUserRole() == "super_admin";
    }

    function isAdmin() {
      return request.auth != null && (
        getUserRole() == "admin" || getUserRole() == "super_admin"
      );
    }

    // Verifica si el usuario autenticado es el dueño del armador dado su doc ID
    function isArmadorOwner(armadorDocId) {
      return request.auth != null
        && armadorDocId != null
        && get(/databases/$(database)/documents/armadores/$(armadorDocId)).data.authUid == request.auth.uid;
    }

    // ─── Users ─────────────────────────────────────────────────
    // Los documentos de "users" se crean y actualizan EXCLUSIVAMENTE desde
    // el servidor (Admin SDK: /api/claim-invite y /api/admins), que
    // bypassa estas reglas. Por eso el cliente ya no tiene ningún permiso
    // de create/update aquí: así se evita que la app cree perfiles con un
    // ID que no es el uid real de Google (el bug de los "admins fantasma").
    match /users/{userId} {
      // Cualquiera autenticado puede leer su propio perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      // Super admin puede leer todos
      allow read: if isSuperAdmin();
      // Admin puede leer usuarios de su empresa
      allow read: if isAdmin() && resource.data.companyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
      // Sin create/update/delete desde el cliente: todo pasa por el Admin SDK.
    }

    // ─── Invitations ───────────────────────────────────────────
    // Solo se leen/escriben desde el servidor (Admin SDK). Sin reglas
    // explícitas de create/read/update/delete para el cliente => denegado
    // por defecto.

    // ─── Armadores ─────────────────────────────────────────────
    // Roster de armadores de cada empresa. Lo administra el admin/super admin
    // de la empresa (crear/editar/borrar). El armador en sí obtiene acceso
    // automáticamente con el correo que el admin le puso aquí: al iniciar
    // sesión con esa cuenta de Google, /api/claim-invite busca ese correo en
    // este roster y crea su perfil — sin invitación aparte. Ese endpoint usa
    // el Admin SDK y bypassa estas reglas, así que no necesita permiso de
    // escritura aquí para vincular armadores/{armadorId}.authUid.
    match /armadores/{armadorId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Admin puede actualizar cualquier campo
      allow update: if isAdmin();
      // El armador puede actualizar campos limitados en su propio documento
      // (activeSession para persistir timer, membreteId para reclamar membrete)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeSession", "membreteId"]);
    }

    // ─── Companies ─────────────────────────────────────────────
    match /companies/{companyId} {
      // Super admin puede leer todas las empresas
      allow read: if isSuperAdmin();
      // Cualquier usuario autenticado (admin o armador) puede leer su propia empresa
      allow read: if request.auth != null && resource.id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
      // Super admin puede crear/eliminar empresas
      allow create, delete: if isSuperAdmin();
      // Super admin puede actualizar cualquier campo
      allow update: if isSuperAdmin();
      // Admin puede actualizar su propia empresa (para control de jornada, etc.)
      allow update: if isAdmin()
        && resource.id == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // ─── Zones ─────────────────────────────────────────────────
    match /zones/{zoneId} {
      // Autenticados pueden leer
      allow read: if request.auth != null;
      // Admin y super admin pueden escribir cualquier campo
      allow write: if isAdmin();
      // El armador dueno de la zona (Zone.armadorId -> Armador.id, vinculado
      // via users/{uid}.armadorId) puede actualizar SOLO los campos de
      // seguimiento en vivo de su propio trabajo (arrancar/pausar/terminar
      // su escaneo) -- nunca reasignar la zona ni tocar los datos del
      // pedido (sector, prioridad, pallet, productos, etc). Antes esto
      // estaba bloqueado por completo (solo isAdmin() podia escribir), por
      // lo que el estado nunca se actualizaba cuando el armador escaneaba:
      // el mapa del admin se quedaba desactualizado en tiempo real.
      allow update: if request.auth != null
        && resource.data.armadorId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.armadorId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "startedAt", "finishedAt", "avgMinutes", "completedSessions", "lastEditedBy", "lastEditedByName", "lastEditedAt"]);
    }

    // ─── Membretes (ordenes de picking) ────────────────────────
    // Cada membrete es una orden de picking asignada a una zona.
    // Admin puede CRUD completo. Armador puede leer todos y actualizar
    // campos de seguimiento en los suyos (claim, marcar productos, etc).
    match /membretes/{membreteId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Admin puede cualquier update
      allow update: if isAdmin();
      // Armador puede reclamar un membrete pendiente (claim: status pending→active, asignar armadorId)
      allow update: if request.auth != null
        && resource.data.status == "pending"
        && resource.data.armadorId == null
        && request.resource.data.status == "active"
        && isArmadorOwner(request.resource.data.armadorId);
      // Armador puede actualizar campos de seguimiento en membrete que ya le pertenece
      allow update: if request.auth != null
        && isArmadorOwner(resource.data.armadorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "armadorId", "armadorName", "status", "assignedAt", "startedAt",
          "claimedAt", "completedAt", "finishedAt", "durationMs", "totalProducts",
          "totalUnits", "incidentNote", "incidentClass", "incidentResolvedAt",
          "incidentResolvedBy", "incidentResolvedByName", "incidentResolutionNote",
          "products", "lastEditedBy", "lastEditedByName", "lastEditedAt"
        ]);
    }

    // ─── Picking (datos reales de producción) ─────────────
    // Registros de picking (cantidad/tiempo/costo real por zona). El admin
    // los crea a mano o por carga masiva de Excel; todos los autenticados
    // pueden leerlos (reportes, historial).
    match /pickings/{pickingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Actividad (bitácora / historial de movimiento) ─────────────
    // Colección de solo-agregado (append-only): cada asignación, escaneo,
    // registro de picking o carga SAP deja una entrada aquí. Nadie edita ni
    // borra el historial — ni siquiera el admin — por eso no hay update/delete.
    match /activity/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ─── Sessions ──────────────────────────────────────────────
    match /sessions/{sessionId} {
      // Autenticados pueden leer
      allow read: if request.auth != null;
      // Armador puede crear sus propias sesiones
      allow create: if request.auth != null && request.resource.data.armadorId == request.auth.uid;
      // Admin y super admin pueden actualizar cualquier sesión; el armador
      // dueño de la sesión puede actualizar la suya (p. ej. marcar endTime/duration).
      allow update: if isAdmin() || (request.auth != null && resource.data.armadorId == request.auth.uid);
    }
  }
}
